@model AddIncidentViewModel


<div id="add-incident-modal" class="modal fade add-incident-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-body">

                <div class="incident-success alert alert-success d-none"></div>

                <h3 class="train-number-heading">Train Number <span></span></h3>

                <form class="add-incident-form text-black" method="post">
                    @Html.AntiForgeryToken()
                    <input class="train-id-input" type="hidden" name="trainID" value="">

                    <div class="mb-3">
                        <label asp-for="Username" for="username" class="col-form-label">Username:</label>
                        <input asp-for="Username" type="text" class="form-control" id="username" name="Username" autocomplete="on">
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Reason" for="reason" class="col-form-label">Reason:</label>
                        <textarea asp-for="Reason" class="form-control" id="reason" name="Reason"></textarea>
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label for="comment" class="col-form-label">Additional Comment:</label>
                        <textarea class="form-control" id="comment" rows="4" name="Comment"></textarea>
                    </div>

                    <span class="server-errors text-danger"></span>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

                <button id="save-incident-form" type="button" class="btn btn-primary save-incident">
                    <span class="spinner-border spinner-border-sm d-none"></span>
                    Save changes
                </button>
            </div>
        </div>
    </div>
</div>
