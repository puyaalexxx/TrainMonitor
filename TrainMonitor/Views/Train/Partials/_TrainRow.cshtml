<div id="train-row" class="train-row row py-2 text-decoration-none border-top border-end border-start d-none">
    <div class="train-col col-12 col-md-2 train-number"></div>
    <div class="train-col col-12 col-md-2 train-name"></div>
    <div class="train-col col-12 col-md-2 train-nexstation"></div>
    <div class="train-col col-12 col-md-1 train-delaytime"></div>
    <div class="train-col col-12 col-md-2 train-last-updated-time"></div>
    <div class="train-col col-12 col-md-1 train-add-incident"></div>
    <div class="train-col col-12 col-md-2 train-incident-history">
        <a href=""
           target="_blank"
           class="btn btn-sm btn-danger btn-view-history d-none"
           title="View Incident History">
            <i class="fas fa-bell"></i>
