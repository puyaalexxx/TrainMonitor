@{
    Layout = "_Layout";
}

<h1 class="mb-4">@ViewBag.Title</h1>

<div id="train-table" class="display-table border-bottom">
    <!-- Header -->
    <div class="top-header row bg-dark font-weight-bold py-2 text-white">
        <div class="train-col col-12 col-md-2">Train Number</div>
        <div class="train-col col-12 col-md-2">Train Name</div>
        <div class="train-col col-12 col-md-2">Next Station</div>
        <div class="train-col col-12 col-md-1">Delay Time</div>
        <div class="train-col col-12 col-md-2">Last Update</div>
        <div class="train-col col-12 col-md-1">Incident</div>
        <div class="train-col col-12 col-md-2">Incidents</div>
    </div>

    <!-- Rows -->
    <div id="train-rows-content">

        <!-- Loading Message -->
        <partial name="Partials/_LoadingMessage" />

        <!-- Row -->
        <partial name="Partials/_TrainRow" />

    </div>

    <!-- Add Incident Modal -->
    <partial name="Partials/_IncidentModal" />
</div>