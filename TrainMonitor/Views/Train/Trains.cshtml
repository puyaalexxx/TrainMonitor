@model List<TrainViewModel>

@{
    Layout = "_Layout";
}

<h1 class="mb-4">@ViewBag.Title</h1>


<div id="train-table" class="display-table border-bottom">
    <!-- Header -->
    <div class="top-header row bg-dark font-weight-bold py-2 text-white">
        <div class="col-2">Train Number</div>
        <div class="col-2">Train Name</div>
        <div class="col-2">Next Station</div>
        <div class="col-1">Delay Time</div>
        <div class="col-2">Last Update</div>
        <div class="col-1">Incident</div>
        <div class="col-2">Incidents</div>
    </div>

    <!-- Rows -->
    <div id="train-rows-content">

        <!-- Loading indicator -->
        <div id="loading-message" class="row py-3 text-center text-muted justify-content-center align-items-center">
            <div class="spinner-border me-2">
                <span class="visually-hidden">Loading...</span>
            </div>
            Fetching live train data...
        </div>

        <!-- Row -->
        <div id="train-row" class="row py-2 text-decoration-none border-top d-none">
            <div class="col-2 train-number"></div>
            <div class="col-2 train-name"></div>
            <div class="col-2 train-nexstation"></div>
            <div class="col-1 train-delaytime"></div>
            <div class="col-2 train-last-updated-time"></div>
            <div class="col-1 train-add-incident"></div>
            <div class="col-2 train-incident-history">
                <a href=""
                   target="_blank"
                   class="btn btn-sm btn-danger btn-view-history d-none"
                   title="View Incident History">
                    <i class="fas fa-bell"></i>
                    View History
                </a>
                <span class="btn btn-sm btn-dark btn-no-incidents d-none"
                      title="No Incident History">
                    <i class="fas fa-bell-slash"></i>
                    No History
                </span>

            </div>

            @* <partial name="Partials/_IncidentModal" model="new AddIncidentViewModel { TrainId = train.TrainId }" /> *@
        </div>
    </div>
</div>