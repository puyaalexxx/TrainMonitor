@model List<IncidentViewModel>

@{
    Layout = "_Layout";
}

@if (Model != null && Model.Any())
{
    <h1 class="mb-4">@ViewBag.Title</h1>

    <div class="display-table border-bottom">
        <!-- Header -->
        <div class="top-header row bg-dark font-weight-bold py-2 text-white">
            <div class="train-col col-12 col-md-2">#</div>
            <div class="train-col col-12 col-md-3">Username</div>
            <div class="train-col col-12 col-md-3">Reason</div>
            <div class="train-col col-12 col-md-4">Additional Comment</div>
        </div>

        <!-- Rows -->
        <div class="train-rows-content">
            @foreach (var (incident, index) in Model.Select((value, i) => (value, i)))
            {
                <div class="train-row row py-2 text-decoration-none text-dark bg-grey-light border-end border-start border-top">
                    <div class="train-col col-12 col-md-2">@(index + 1)</div>
                    <div class="train-col col-12 col-md-3">@incident.Username</div>
                    <div class="train-col col-12 col-md-3">@incident.Reason</div>
                    <div class="train-col col-12 col-md-4">@incident.Comment</div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="text-center py-4">
        <h3>No incidents recorded for this train.</h3>
    </div>
}

