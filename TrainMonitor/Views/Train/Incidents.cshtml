@model List<TrainsWithIncidentsViewModel>

@{
    Layout = "_Layout";
}

@if (Model != null && Model.Any())
{
    <h1 class="mb-4">@ViewBag.Title</h1>

    @foreach (var train in Model)
    {
        <div class="all-incidents card mb-5">

            @* Train Header *@
            <div class="card-header bg-danger text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <span class="fw-bold" title="Train Name">@train.TrainName</span>
                        <small class="badge bg-light text-danger ms-2" title="Train Number">@train.TrainNumber</small>
                    </h4>
                    <a asp-action="GetTrainIncidents" asp-route-trainID="@train.TrainId"
                       class="btn btn-sm btn-light text-danger fw-medium"
                       title="Train Incidents">
                        View Full History
                    </a>
                </div>
            </div>

            @* Incidents Table Body *@
            <div class="card-body p-0">
                <div class="display-table border-bottom">

                    <div class="top-header row bg-dark font-weight-bold py-2 text-white m-0">
                        <div class="train-col col-12 col-md-2">#</div>
                        <div class="train-col col-12 col-md-3">Username</div>
                        <div class="train-col col-12 col-md-3">Reason</div>
                        <div class="train-col col-12 col-md-4">Additional Comment</div>
                    </div>

                    @* Incident Rows *@
                    <div class="train-rows-content">
                        @*Iterate through the Incidents for this specific train *@
                        @foreach (var (incident, index) in train.Incidents.Select((value, i) => (value, i)))
                        {
                            <div class="train-row row py-2 text-decoration-none text-dark bg-grey-light border-end border-start border-top m-0">
                                <div class="train-col col-12 col-md-2">@(index + 1)</div>
                                <div class="train-col col-12 col-md-3">@incident.Username</div>
                                <div class="train-col col-12 col-md-3">@incident.Reason</div>
                                <div class="train-col col-12 col-md-4">@incident.Comment</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="text-center py-4">
        <h3>No incidents recorded for this train.</h3>
    </div>
}